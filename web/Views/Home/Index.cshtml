@{
    ViewData["Title"] = "Home Page";
}
@model List<web.Models.Customer>
@{
    var customers = ViewBag.Customers2 as List<Customer>;
}
<style>
    .home-container {
        max-width: 900px;
        margin: 50px auto;
        padding: 40px 30px;
        background-color: #ffffff;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        text-align: center;
    }

    .home-avatar {
        width: 120px;
        height: 120px;
        line-height: 120px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background-color: #2563eb;
        color: white;
        font-size: 42px;
        font-weight: bold;
    }

    .home-title {
        font-size: 40px;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 10px;
    }

    .home-subtitle {
        font-size: 20px;
        color: #6b7280;
        margin-bottom: 25px;
    }

    .home-desc {
        max-width: 650px;
        margin: 0 auto 30px;
        color: #4b5563;
        font-size: 17px;
        line-height: 1.8;
    }

    .home-tags {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 30px;
    }

    .home-tag {
        padding: 8px 14px;
        background-color: #eff6ff;
        color: #1d4ed8;
        border-radius: 999px;
        font-size: 14px;
        font-weight: 600;
    }

    .home-links {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .home-btn {
        display: inline-block;
        padding: 12px 20px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.2s;
    }

    .home-btn-primary {
        background-color: #2563eb;
        color: white;
    }

        .home-btn-primary:hover {
            background-color: #1d4ed8;
            color: white;
        }

    .home-btn-secondary {
        background-color: #f3f4f6;
        color: #374151;
    }

        .home-btn-secondary:hover {
            background-color: #e5e7eb;
            color: #111827;
        }
</style>

<div class="home-container">
    <div class="home-avatar">M</div>
   

    @foreach (var item in customers)
    {
    <p>
        Id：@item.Id <br />
        姓名：@item.Name <br />
        城市：@item.City <br />
        地址：@item.Address
    </p>
    <hr />
    }
       
        
   
     
        
    
    <h1 class="home-title">大家好，我是 Mike</h1>
    <div class="home-subtitle">ASP.NET Core MVC 練習首頁</div>

    <p class="home-desc">
        這是我練習 ASP.NET Core MVC 的個人首頁，目前正在學習
        Controller、View、Model、路由、CRUD 與基本前端排版，
        一步一步把自己的 Web 功能做出來。
    </p>

    <div class="home-tags">
        <span class="home-tag">ASP.NET Core MVC</span>
        <span class="home-tag">C#</span>
        <span class="home-tag">CRUD</span>
        <span class="home-tag">Razor View</span>
    </div>

    <div class="home-links">
        <a class="home-btn home-btn-primary" asp-controller="Home" asp-action="Customer">查看客戶清單</a>
        <a class="home-btn home-btn-secondary" asp-controller="Home" asp-action="Hello">前往 Hello 頁</a>
    </div>
</div>